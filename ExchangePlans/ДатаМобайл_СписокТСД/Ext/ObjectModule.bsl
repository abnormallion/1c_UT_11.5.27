
Процедура ПередЗаписью(Отказ)
	
	Если АтрибутыДляПечати.Количество() Тогда
		Результат = ПроверкаНаУникальностьНазванияПеременных();	
		
		Если Результат.ЕстьДубли Тогда
			Отказ = Истина;
			Сообщить("Значение в поле """ + Результат.ТекстОшибки + """ не уникально");
		КонецЕсли;	
	КонецЕсли;	
	
	Для каждого Строка Из АтрибутыДляПечати Цикл
		Если ЕстьКириллица(Строка.НазваниеПеременной) Тогда
			Отказ = Истина;
			Сообщить("В названии переменной: " + Строка.НазваниеПеременной + " есть символы кириллицы!");
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры    

Функция ЕстьКириллица(ИсходнаяСтрока) Экспорт
	
	ЕстьКириллица = Ложь;
	ИсходнаяСтрока = СокрЛП(ИсходнаяСтрока);
	
	Если СтрДлина(ИсходнаяСтрока) > 0 Тогда
		Для Сч = 1 по СтрДлина(ИсходнаяСтрока) Цикл
			Символ = НРег(Сред(ИсходнаяСтрока, Сч, 1));
			
			Если Найти("абвгдеёжзийклмнопрстуфхцчшщъыьэюя", Символ) Тогда
				ЕстьКириллица=истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьКириллица;    
	
КонецФункции

Функция ПроверкаНаУникальностьНазванияПеременных()
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.НазваниеПеременной КАК НазваниеПеременной
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&ВТ КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НазваниеПеременной КАК НазваниеПеременной,
	|	СУММА(1) КАК Дубли
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.НазваниеПеременной
	|ИМЕЮЩИЕ
	|	СУММА(1) > 1";
	Запрос.УстановитьПараметр("ВТ", АтрибутыДляПечати.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Результат.Вставить("ЕстьДубли", Истина);
		Выборка = РезультатЗапроса.Выбрать();
		ТекстОшибки = "";
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = ТекстОшибки + " " + Выборка.НазваниеПеременной;	
		КонецЦикла;	 
		Результат.Вставить("ТекстОшибки", ТекстОшибки);
	Иначе     
		Результат.Вставить("ЕстьДубли", Ложь); 
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	
