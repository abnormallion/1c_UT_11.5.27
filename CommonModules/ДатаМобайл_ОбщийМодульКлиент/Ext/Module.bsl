
#Область ПрограммныйИнтерфейс

// Возвращает общий модуль по имени.
//
// Параметры:
//  Имя - Строка - Имя общего модуля.
//
// Возвращаемое значение:
//  ОбщийМодуль - Найденный общий модуль.
//
// Исключения:
//  Генерируется исключение, если модуль не найден.
Функция ОбщийМодуль(Имя) Экспорт
	
	Модуль = ОбщегоНазначенияКлиент.ОбщийМодуль(Имя);
	
	#Если Не ВебКлиент Тогда
		
		// В веб-клиенте не проверяется
		// т.к. при обращении к модулям с вызовом сервера типа такого модуля в веб-клиенте не существует.
		
		Если Имя <> "СтроковыеФункцииКлиентСервер" Тогда
			Модуль_СтроковыеФункцииКлиентСервер = ОбщийМодуль("СтроковыеФункцииКлиентСервер");
		КонецЕсли;
		
		Если ТипЗнч(Модуль) <> Тип("ОбщийМодуль") Тогда
			Если Имя <> "СтроковыеФункцииКлиентСервер" Тогда
				ВызватьИсключение Модуль_СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Общий модуль ""%1"" не найден.'"), 
				Имя);
			Иначе
				ВызватьИсключение НСтр("ru = 'Неизвестное имя общего модуля - СтроковыеФункцииКлиентСервер. Обратитесь к разработчикам программы.'");			
			КонецЕсли;	
		КонецЕсли;
		
	#КонецЕсли
	
	Возврат Модуль;
	
КонецФункции

// Выводит сообщение пользователю.
//
// Параметры:
//  ТекстСообщения - Строка - Текст сообщения.
//  КлючДанных - ЛюбаяСсылка, Неопределено - Ключ данных, с которым связывается сообщение.
//  Поле - Строка - Имя поля формы, с которым связывается сообщение.
//  ПутьКДанным - Строка - Путь к данным формы, с которым связывается сообщение.
//  Отказ - Булево - Признак отказа выполнения операции.
Процедура СообщитьПользователю(Знач ТекстСообщения,	Знач КлючДанных = Неопределено,
	Знач Поле = "", Знач ПутьКДанным = "", Отказ = Ложь) Экспорт
	
	Если Отказ Тогда Возврат; КонецЕсли;
	
	Попытка
		Модуль_ОбщегоНазначенияКлиент = ОбщийМодуль("ОбщегоНазначенияКлиент"); 
		
		Модуль_ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, 
		КлючДанных, Поле, ПутьКДанным, Отказ);
		
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст       = ТекстСообщения;
		Сообщение.КлючДанных  = КлючДанных;
		Сообщение.Поле        = Поле;
		Сообщение.ПутьКДанным = ПутьКДанным;
		
		Сообщение.Сообщить();		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти             																	