
#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МассивОбъектов = Неопределено;
	Параметры.Свойство("МассивОбъектов", МассивОбъектов);
	
	СтруктураЗагрузки = Неопределено;
	Параметры.Свойство("СтруктураДанных", СтруктураЗагрузки);
	
	КонтекстВызова = Неопределено;
	Параметры.Свойство("КонтекстВызова", КонтекстВызова);
	
	Если КонтекстВызова = "СписокШаблонов" Тогда
		КонтекстВызоваИП = "шаблоны";
		КонтекстВызоваРП = "шаблонов";
		
	ИначеЕсли КонтекстВызова = "Роли" Тогда
		КонтекстВызоваИП = "роли";
		КонтекстВызоваРП = "ролей";
		
	ИначеЕсли КонтекстВызова = "СписокТСД" Тогда
		КонтекстВызоваИП = "устройства";
		КонтекстВызоваРП = "устройств";
	КонецЕсли;
	
	// ВЫГРУЗКА
	Если Не МассивОбъектов = Неопределено Тогда
		ОбъектыКоличество = МассивОбъектов.Количество();
		
		ВсеОбъекты.Очистить();
		Объекты.Очистить();
		
		Для каждого СтрокаОбъекта Из МассивОбъектов Цикл
			СтрокаОбъекты = Объекты.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбъекты, СтрокаОбъекта);
			СтрокаОбъекты.Выбран = Истина;
			
			СтрокаВсеОбъекты = ВсеОбъекты.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВсеОбъекты, СтрокаОбъекты);
		КонецЦикла;
		
		ТипОперации = "Экспорт";
	КонецЕсли;
	
	// ЗАГРУЗКА
	Если Не СтруктураЗагрузки = Неопределено Тогда
		ТипОперации = "Импорт";
		ДанныеОбмена = СтруктураЗагрузки; 
		
		ВсеОбъекты.Очистить();
		Объекты.Очистить();
		
		// ПРОВЕРКИ ДАННЫХ
		Если Не ТипЗнч(ДанныеОбмена) = Тип("Структура") Тогда
			Лог = НСтр("ru = 'Неверный формат данных для загрузки!'");
			ВызватьИсключение(Лог);
		КонецЕсли; 
		
		ОбъектыДанных = Неопределено;
		ДанныеОбмена.Свойство("Объекты", ОбъектыДанных);
		
		ТипДанных = Неопределено;
		ДанныеОбмена.Свойство("Тип", ТипДанных);
		
		ИмяДанных = Неопределено;
		ДанныеОбмена.Свойство("Имя", ИмяДанных);
		
		Если Не ТипЗнч(ОбъектыДанных) = Тип("Массив") Или Не ЗначениеЗаполнено(ТипДанных) Или Не ЗначениеЗаполнено(ИмяДанных) Тогда
			Лог = НСтр("ru = 'Неверный формат данных для загрузки!'");
			ВызватьИсключение(Лог);
		КонецЕсли; 
		
		ОбъектыКоличество = ОбъектыДанных.Количество();
		
		// ЗАГРУЗКА
		Для каждого ОбъектДанных Из ОбъектыДанных Цикл 
			ОбъектКод = Неопределено;
			ОбъектДанных.Свойство("Код", ОбъектКод);
			
			ОбъектНаименование = Неопределено;
			ОбъектДанных.Свойство("Наименование", ОбъектНаименование);
			
			СтрокаОбъекты = Объекты.Добавить();
			СтрокаОбъекты.Код = ОбъектКод;
			СтрокаОбъекты.Наименование = ОбъектНаименование;
			СтрокаОбъекты.Выбран = Истина;
			
			СтрокаВсеОбъекты = ВсеОбъекты.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВсеОбъекты, СтрокаОбъекты);
		КонецЦикла;
	КонецЕсли; 
	
	ЗаголовокФормы = "" + ТипОперации + " " + КонтекстВызоваРП;
	
	ЗаголовокШапки = "Выберите %1.";
	ЗаголовокШапки = СтрШаблон(ЗаголовокШапки, КонтекстВызоваИП);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗаголовокФормы <> "" Тогда
		ЭтаФорма.Заголовок = ЗаголовокФормы;
	КонецЕсли; 
	
	Если ЗаголовокШапки <> "" Тогда
		Элементы.НадписьШапки.Заголовок = ЗаголовокШапки;
	КонецЕсли;
	
	Элементы.КнопкаВыполнить.Заголовок = ?(ТипОперации = "Экспорт", "Экспортировать", "Импортировать");
	
КонецПроцедуры

#КонецОбласти

#Область СобытияЭлементовФорм

&НаКлиенте
Процедура ВыбратьВсе(Команда)
	
	Для каждого Строка Из ВсеОбъекты Цикл
		Строка.Выбран = Истина;
	КонецЦикла;

	ОбновитьТаблицу();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВыбор(Команда)
	
	Для каждого Строка Из ВсеОбъекты Цикл
		Строка.Выбран = Ложь;
	КонецЦикла;

	ОбновитьТаблицу();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивОбъектовНаЭкспорт(МассивОтмеченных) 
	
	МассивОбъектовНаЭкспорт = Новый Массив;
	МассивКодов = МассивОтмеченных;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивКодов", МассивКодов);
	Запрос.Текст = "ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДатаМобайл_ШаблоныДокументов КАК Спр
	|ГДЕ
	|	Спр.Код В(&МассивКодов)"; 
	
	Если КонтекстВызова = "Роли" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДатаМобайл_ШаблоныДокументов", "ДатаМобайл_Роли");
		
	ИначеЕсли КонтекстВызова = "СписокТСД" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.ДатаМобайл_ШаблоныДокументов", "ПланОбмена.ДатаМобайл_СписокТСД");
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		МассивОбъектовНаЭкспорт = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат МассивОбъектовНаЭкспорт;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивОтмеченныхОбъектов() 
	
	Возврат ВсеОбъекты.Выгрузить(Новый Структура("Выбран", Истина)).ВыгрузитьКолонку("Код");
	
КонецФункции

&НаСервере
Функция ПолучитьМассивОбъектовИсключений() 
	
	МассивОбъектовИсключений = Новый Массив;
	СтрокиИсключений = ВсеОбъекты.Выгрузить(Новый Структура("Выбран", Ложь));
	
	Для каждого СтрокаИсключения Из СтрокиИсключений Цикл
		СтруктураИсключения = Новый Структура;
		СтруктураИсключения.Вставить("Код", СтрокаИсключения.Код);
		СтруктураИсключения.Вставить("Наименование", СтрокаИсключения.Наименование);
		МассивОбъектовИсключений.Добавить(СтруктураИсключения);
	КонецЦикла;
	
	Возврат МассивОбъектовИсключений;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	МассивОтмеченных = ПолучитьМассивОтмеченныхОбъектов();  
	
	Если МассивОтмеченных.Количество() = 0 Тогда
		Попытка
			ДатаМобайл_ОбщийМодульКлиент.СообщитьПользователю("Ошибка: Не выбраны объекты."); 
		Исключение
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Ошибка: Не выбраны объекты.";
			Сообщение.Сообщить();
		КонецПопытки;
		
		Возврат;
	КонецЕсли;
	
	ДанныеВозврата = Неопределено;
	
	Если ТипОперации = "Экспорт" Тогда
		ДанныеВозврата = ПолучитьМассивОбъектовНаЭкспорт(МассивОтмеченных);
	Иначе
		МассивИсключений = ПолучитьМассивОбъектовИсключений();
		ДанныеВозврата = Новый Структура("СтруктураДанных, МассивИсключений, КонтекстВызова", ДанныеОбмена, МассивИсключений, КонтекстВызова);
	КонецЕсли;
	
	ЭтаФорма.Закрыть(ДанныеВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	
	ОбновитьТаблицу();

КонецПроцедуры 

&НаКлиенте
Процедура ОбновитьТаблицу()

	Объекты.Очистить();
	ТекстПоиска = НРег(СокрЛП(СтрокаПоиска));

	Для каждого ИсходнаяСтрока Из ВсеОбъекты Цикл
		Если Не ПустаяСтрока(ТекстПоиска) Тогда
			НайденоВНаименовании =
				СтрНайти(
					НРег(ИсходнаяСтрока.Наименование),
					ТекстПоиска
				) > 0;

			НайденоВКоде =
				СтрНайти(
					НРег(ИсходнаяСтрока.Код),
					ТекстПоиска
				) > 0;

			Если Не НайденоВНаименовании И Не НайденоВКоде Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Строка = Объекты.Добавить();
		Строка.Выбран 		= ИсходнаяСтрока.Выбран;
		Строка.Наименование = ИсходнаяСтрока.Наименование;
		Строка.Код 			= ИсходнаяСтрока.Код;
	КонецЦикла;

	КоличествоШаблонов = Объекты.Количество();

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыВыбранПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Объекты.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для каждого Строка Из ВсеОбъекты Цикл
		Если Строка.Код = ТекущаяСтрока.Код Тогда
			Строка.Выбран = ТекущаяСтрока.Выбран;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
