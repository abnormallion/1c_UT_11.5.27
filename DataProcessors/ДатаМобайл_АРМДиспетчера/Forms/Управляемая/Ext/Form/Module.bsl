// ВЫГРУЗКА
&НаСервере
Процедура ВыгрузитьВФайл(ПутьКФайлу, ПараметрыВыгрузки)
	
	МассивСсылок   = Неопределено;
	КонтекстВызова = Неопределено;
	
	ПараметрыВыгрузки.Свойство("ИмяОбъектаЗапроса", КонтекстВызова);
	ПараметрыВыгрузки.Свойство("МассивСсылок", МассивСсылок);
	
	Если КонтекстВызова = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(КонтекстВызова, "Справочник.") = 0 Тогда
		ИмяОбъектаМетаданных = СтрЗаменить(КонтекстВызова, "ПланОбмена.", "");
		ТипыМетаданных = "ПланыОбмена";
		ТипМетаданных  = "ПланОбмена";
	Иначе
		ИмяОбъектаМетаданных = СтрЗаменить(КонтекстВызова, "Справочник.", "");
		ТипыМетаданных = "Справочники";
		ТипМетаданных  = "Справочник";
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные[ТипыМетаданных][ИмяОбъектаМетаданных];
	
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Не найден объект с именем: " + ИмяОбъектаМетаданных;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
		|	Данные.Ссылка,
		|	Данные.Наименование,
		|	Данные.Код";
	
	// Добавляем все реквизиты
	Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		ИмяРеквизита = Реквизит.Имя;
		ТекстЗапроса = ТекстЗапроса + ",
		|	Данные." + ИмяРеквизита + " КАК " + ИмяРеквизита;
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
		|ИЗ
		|	" + ТипМетаданных + "." + ИмяОбъектаМетаданных + " КАК Данные
		|
		|ГДЕ
		|	1 = 1";
	
	Если Не МассивСсылок = Неопределено Тогда 
		ТекстЗапроса = ТекстЗапроса + "
		|
		|	И Данные.Ссылка В(&МассивЭлементов)
		|";
		
		Запрос.УстановитьПараметр("МассивЭлементов", МассивСсылок);
	КонецЕсли; 
	
	Если ТипыМетаданных = "ПланыОбмена" Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "1 = 1", "НЕ Данные.ЭтотУзел");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить().Выгрузить();
		
	// XML-запись
    Запись = Новый ЗаписьXML;;
    Запись.ОткрытьФайл(ПутьКФайлу);

    Запись.ЗаписатьНачалоЭлемента("Объекты"); // Объекты
	Запись.ЗаписатьАтрибут("Тип", ТипМетаданных);
    Запись.ЗаписатьАтрибут("Имя", ИмяОбъектаМетаданных);
	
	Для каждого ЭлементДанных Из Результат Цикл		
		ОбъектСправочника = ЭлементДанных.Ссылка.ПолучитьОбъект();
		
		Запись.ЗаписатьНачалоЭлемента("Объект"); // Объект
		Запись.ЗаписатьАтрибут("Наименование", ЭлементДанных.Наименование);
		
		Если ТипЗнч(ЭлементДанных.Код) = Тип("Число") Тогда
			Запись.ЗаписатьАтрибут("Код", Формат(ЭлементДанных.Код, "ЧРД=.; ЧГ=0"));
		Иначе
			Запись.ЗаписатьАтрибут("Код", ЭлементДанных.Код);
		КонецЕсли;
		
		Запись.ЗаписатьНачалоЭлемента("Реквизиты"); // Реквизиты
		
		Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			ЗаписатьЗначениеРеквизита(Запись, Реквизит.Имя, ЭлементДанных[Реквизит.Имя]);
		КонецЦикла; 
		
		Запись.ЗаписатьКонецЭлемента(); // Реквизиты
		
		Запись.ЗаписатьНачалоЭлемента("ТабличныеЧасти"); // Табличные части

		// Табличные части
		Для каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
			ИмяТабЧасти = ТабличнаяЧасть.Имя;
			ДанныеТабЧасти = ОбъектСправочника[ИмяТабЧасти].Выгрузить();
			
			Запись.ЗаписатьНачалоЭлемента("ТабличнаяЧасть"); // ТабЧасть
			Запись.ЗаписатьАтрибут("Имя", ИмяТабЧасти);
			
			Для каждого СтрТаб Из ДанныеТабЧасти Цикл 
				Запись.ЗаписатьНачалоЭлемента("СтрокаТабличнойЧасти"); // Строка ТЧ
				
				Для каждого КолонкаТЧ Из ДанныеТабЧасти.Колонки Цикл
					ИмяКолонки = КолонкаТЧ.Имя; 
					
					// служебный реквизит строки ТЧ
					Если ИмяКолонки = "НомерСтроки" Тогда 
						Продолжить; 
					КонецЕсли;  
					
					ЗначениеКолонки = СтрТаб[ИмяКолонки];
					
					Если ЗначениеКолонки = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					ЗаписатьЗначениеРеквизита(Запись, ИмяКолонки, ЗначениеКолонки);
				КонецЦикла; 
				
				Запись.ЗаписатьКонецЭлемента(); // Строка ТЧ
			КонецЦикла;
			
			Запись.ЗаписатьКонецЭлемента(); // ТабЧасть
		КонецЦикла; 
		
		Запись.ЗаписатьКонецЭлемента(); // Табличные части
		
		Запись.ЗаписатьКонецЭлемента(); // Объект
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); // Объекты
	Запись.Закрыть(); 
	
	// оповещение
	ДанныхВыгружено = Нстр("ru = 'Выгружено объектов: %Выгружено'");
	КоличествоВыгружено = Результат.Количество();
	СообщениеВыгружено = СтрЗаменить(ДанныхВыгружено, "%Выгружено", КоличествоВыгружено);
	ДатаМобайл_ОбщийМодуль.СообщитьПользователю(СообщениеВыгружено);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗначениеРеквизита(СтруктураXML, ИмяРеквизита, Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	//СтруктураXML.ЗаписатьНачалоЭлемента(ИмяРеквизита); // Реквизит
	СтруктураXML.ЗаписатьНачалоЭлемента("Реквизит"); // Реквизит
	СтруктураXML.ЗаписатьАтрибут("Имя", ИмяРеквизита);
	
	Если ТипЗначения = Тип("Дата") Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "Дата");
		СтруктураXML.ЗаписатьАтрибут("Значение", Формат(Значение, "ДФ='dd.MM.yyyy чч:мм:сс'"));
		
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "Булево");
		СтруктураXML.ЗаписатьАтрибут("Значение", Формат(Значение, "БЛ=Ложь; БИ=Истина"));
		
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "Число");
		СтруктураXML.ЗаписатьАтрибут("Значение", Формат(Значение, "ЧРД=.; ЧГ=0"));
		
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "Строка");
		СтруктураXML.ЗаписатьАтрибут("Значение", Строка(Значение));
		
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		ПеречислениеМетаданные = Значение.Метаданные();
		
		СтруктураXML.ЗаписатьАтрибут("Тип", "Перечисление"); 
		СтруктураXML.ЗаписатьАтрибут("ИмяМетаданных", ПеречислениеМетаданные.Имя);
		
		Если ЗначениеЗаполнено(Значение) Тогда
			Для каждого Элемент Из ПеречислениеМетаданные.ЗначенияПеречисления Цикл
				Если Элемент.Синоним = Строка(Значение) Тогда
					СтруктураXML.ЗаписатьАтрибут("Значение", Элемент.Имя);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			СтруктураXML.ЗаписатьАтрибут("Значение", "");
		КонецЕсли;		
		
	ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "Справочник");
		СтруктураXML.ЗаписатьАтрибут("ИмяМетаданных", Значение.Метаданные().Имя);
		СтруктураXML.ЗаписатьАтрибут("Наименование", Значение.Наименование);
		
		Если ТипЗнч(Значение.Код) = Тип("Число") Тогда
			СтруктураXML.ЗаписатьАтрибут("Значение", Формат(Значение.Код, "ЧРД=.; ЧГ=0"));
		Иначе
			СтруктураXML.ЗаписатьАтрибут("Код", Значение.Код);
		КонецЕсли;
		
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "ПланВидовХарактеристик");
		СтруктураXML.ЗаписатьАтрибут("ИмяМетаданных", Значение.Метаданные().Имя);
		СтруктураXML.ЗаписатьАтрибут("Наименование", Значение.Наименование);
		
		Если ТипЗнч(Значение.Код) = Тип("Число") Тогда
			СтруктураXML.ЗаписатьАтрибут("Значение", Формат(Значение.Код, "ЧРД=.; ЧГ=0"));
		Иначе
			СтруктураXML.ЗаписатьАтрибут("Код", Значение.Код);
		КонецЕсли;
		
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		СтруктураXML.ЗаписатьАтрибут("Тип", "Документ");
		СтруктураXML.ЗаписатьАтрибут("ИмяМетаданных", Значение.Метаданные().Имя);
		СтруктураXML.ЗаписатьАтрибут("Номер", Значение.Номер);
		СтруктураXML.ЗаписатьАтрибут("Дата", Формат(Значение.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		
	Иначе
		СтруктураXML.ЗаписатьАтрибут("Тип", "Прочее");
		СтруктураXML.ЗаписатьАтрибут("Значение", Строка(Значение));
	КонецЕсли;
	
	СтруктураXML.ЗаписатьКонецЭлемента(); // Реквизит
	
КонецПроцедуры


// ЗАГРУЗКА 
&НаКлиенте
Процедура ПослеВыбораОбъектовДляЗагрузкиНастроек(РезультатЗакрытия, ДополнительныеПараметры) Экспорт  
	
	Если РезультатЗакрытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Загружено = 0;
	Лог = ЗагрузитьДанныеИзСтруктурыВБазу(РезультатЗакрытия, Загружено);
	 
	ШаблонЗагружено = Нстр("ru = 'Загружено объектов: %Количество'");
	СообщениеЗагружено = СтрЗаменить(ШаблонЗагружено, "%Количество", Загружено);
	
	Если Лог <> "" Тогда
		СообщениеЗагружено = СообщениеЗагружено + Символы.ПС 
		+ "===============" + Символы.ПС + Лог;
	КонецЕсли;
	
	ДатаМобайл_ОбщийМодуль.СообщитьПользователю(СообщениеЗагружено);

	// Обновление Формы
	КонтекстВызова = РезультатЗакрытия.КонтекстВызова;
	
	Если КонтекстВызова = "СписокШаблонов" Тогда 
		Элементы.СписокШаблонов.Обновить();
	ИначеЕсли КонтекстВызова = "Роли" Тогда 
		Элементы.Роли.Обновить();
	ИначеЕсли КонтекстВызова = "СписокТСД" Тогда 
		Элементы.СписокТСД.Обновить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСозданиеДвоичныхДанныхИзФайла_ОбработкаОповещения(ДвоичныеДанные, ДополнительныеПараметры) Экспорт
	
	ДвДанные_АдресВХ = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ЭтотОбъект.УникальныйИдентификатор);
	СтруктураДанныхДляЗагрузки = ЗагрузитьИзФайла(ДополнительныеПараметры.КонтекстВызова, ДвДанные_АдресВХ);
	
	ОповещениеПослеУдаления = Новый ОписаниеОповещения("УдалитьФайлы_ОбработкаОповещения", ЭтотОбъект);
	НачатьУдалениеФайлов(ОповещениеПослеУдаления, ДвДанные_АдресВХ);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВидОперации", "Загрузка");
	СтруктураПараметров.Вставить("СтруктураДанных", СтруктураДанныхДляЗагрузки); 
	СтруктураПараметров.Вставить("КонтекстВызова", ДополнительныеПараметры.КонтекстВызова);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораОбъектовДляЗагрузкиНастроек", ЭтотОбъект); 
	
	ОткрытьФорму("Обработка.ДатаМобайл_АРМДиспетчера.Форма.ФормаЭкспортаИмпортаНастроек",
	СтруктураПараметров,
	ЭтаФорма,,,, 
	ОписаниеОповещения,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьИзФайла(КонтекстВызова, Знач ДвДанные_АдресВХ)
	
	СтруктураДанных = Новый Структура;
	ДвДанные = ПолучитьИзВременногоХранилища(ДвДанные_АдресВХ);                       
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	ДвДанные.Записать(ИмяФайла);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);

	Попытка
		Чтение.Прочитать();
	Исключение
		ВызватьИсключение "Ошибка чтения XML-файла: " + ОписаниеОшибки();
	КонецПопытки;
	
	СтруктураДанных = ПрочитатьXMLВСтруктуруРекурсивно(Чтение);
	Чтение.Закрыть(); 
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаСервере
Функция ПрочитатьXMLВСтруктуруРекурсивно(ЧтениеXML)
 
    // Здесь мы собираем данные текущего узла
    ДанныеУзла = Новый Структура;
	
	ИмяТега = ЧтениеXML.Имя;
	УзелМассив = Новый Массив;
    
    // 1. Читаем атрибуты тега, если они есть
    Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
        Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
            ДанныеУзла.Вставить(ЧтениеXML.Имя, ЧтениеXML.Значение);
        КонецЦикла;
	КонецЕсли; 
    
    // 2. Читаем вложенное содержимое
    Пока ЧтениеXML.Прочитать() Цикл
        ТипУзла = ЧтениеXML.ТипУзла;
        
        Если ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
            ИмяВложенногоТега = ЧтениеXML.Имя;
            
            // Рекурсивный вызов для вложенного узла
            ЗначениеВложенногоУзла = ПрочитатьXMLВСтруктуруРекурсивно(ЧтениеXML);
			УзелМассив.Добавить(ЗначениеВложенногоУзла);
            
        ИначеЕсли ТипУзла = ТипУзлаXML.Текст ИЛИ ТипУзла = ТипУзлаXML.СекцияCDATA Тогда
            // Если внутри тега только простой текст, возвращаем его значение
            Возврат ЧтениеXML.Значение;
            
        ИначеЕсли ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
            // Завершаем чтение текущего уровня вложенности
            Прервать;
        КонецЕсли;
	КонецЦикла; 
	
	Если УзелМассив.Количество() <> 0 Тогда
		ДанныеУзла.Вставить(ИмяТега, УзелМассив);
	КонецЕсли;
    
    // Если у элемента нет дочерних узлов и атрибутов, возвращаем пустую строку
    Если ДанныеУзла.Количество() = 0 Тогда
        Возврат "";
    КонецЕсли;
    
    Возврат ДанныеУзла;
 
КонецФункции

&НаСервере
Функция ЗагрузитьДанныеИзСтруктурыВБазу(СтруктураПараметров, Загружено) 
	
	Лог = ""; 
	
	// ПРОВЕРКИ ДАННЫХ
	СтруктураДанных = Неопределено;
	СтруктураПараметров.Свойство("СтруктураДанных", СтруктураДанных);
	
	МассивИсключений = Неопределено;
	СтруктураПараметров.Свойство("МассивИсключений", МассивИсключений);
	
	Если СтруктураДанных = Неопределено Тогда
		Лог = НСтр("ru = 'Нет данных для загрузки!'");
		Возврат Лог;
	КонецЕсли;
	
	Если Не ТипЗнч(СтруктураДанных) = Тип("Структура") Тогда
		Лог = НСтр("ru = 'Неверный формат данных для загрузки!'");
		Возврат Лог;
	КонецЕсли; 
	
	ОбъектыДанных = Неопределено;
	СтруктураДанных.Свойство("Объекты", ОбъектыДанных);
	
	ТипДанных = Неопределено;
	СтруктураДанных.Свойство("Тип", ТипДанных);
	
	ИмяДанных = Неопределено;
	СтруктураДанных.Свойство("Имя", ИмяДанных);
	
	Если Не ТипЗнч(ОбъектыДанных) = Тип("Массив") Или Не ЗначениеЗаполнено(ТипДанных) Или Не ЗначениеЗаполнено(ИмяДанных) Тогда
		Лог = НСтр("ru = 'Неверный формат данных для загрузки!'");
		Возврат Лог;
	КонецЕсли;
	
	// ЗАГРУЗКА
	Для каждого ОбъектДанных Из ОбъектыДанных Цикл 
		ОбъектКод = Неопределено;
		ОбъектДанных.Свойство("Код", ОбъектКод);
		
		Попытка
			ОбъектКод = Число(ОбъектКод);
		Исключение
			Прервать;
		КонецПопытки;
		
		ОбъектНаименование = Неопределено;
		ОбъектДанных.Свойство("Наименование", ОбъектНаименование); 
		
		ОбъектМетаданные = Неопределено;
		ОбъектДанных.Свойство("Объект", ОбъектМетаданные);
		
		ЕстьВИсключениях = Ложь;
		Если Не МассивИсключений.Количество() = 0 Тогда
			Для каждого ОбъектИсключения Из МассивИсключений Цикл 
				Если ОбъектИсключения.Код = ОбъектКод И ОбъектИсключения.Наименование = ОбъектНаименование Тогда 
					ЕстьВИсключениях = Истина;
					Прервать;
				КонецЕсли; 
			КонецЦикла;	
			
			Если ЕстьВИсключениях Тогда
				Продолжить; 
			КонецЕсли;
		КонецЕсли;
		
		ОбъектСсылка = ПолучитьСправочник(ИмяДанных,, ОбъектНаименование, ТипДанных);
		
		Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
			Если ТипДанных = "ПланОбмена" Тогда
				НовыйОбъект = ПланыОбмена[ИмяДанных].СоздатьУзел();
				НовыйОбъект.Код = СокрЛП(ОбъектКод);
			Иначе
				НовыйОбъект = Справочники[ИмяДанных].СоздатьЭлемент();
			КонецЕсли;
			
			НовыйОбъект.Наименование = ОбъектНаименование;
		Иначе
			НовыйОбъект = ОбъектСсылка.ПолучитьОбъект();	
		КонецЕсли;
		
		Если Не ТипЗнч(ОбъектМетаданные) = Тип("Массив") Тогда
			Лог = НСтр("ru = 'Неверный формат данных для загрузки!'");
			Возврат Лог;
		КонецЕсли; 
		
		СтрокаЛога = НСтр("ru = 'Импорт объекта <%1>'");
		СтрокаЛога = СтрШаблон(СтрокаЛога, ОбъектНаименование);
		ДобавитьВЛог(Лог, СтрокаЛога);
	
		Для каждого МетаданныеОбъекта Из ОбъектМетаданные Цикл 
			Если Не ТипЗнч(МетаданныеОбъекта) = Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			
			// Реквизиты
			Реквизиты = Неопределено;
			МетаданныеОбъекта.Свойство("Реквизиты", Реквизиты);
			
			Если ТипЗнч(Реквизиты) = Тип("Массив") Тогда
				УстановкаРеквизитов(Реквизиты, НовыйОбъект, Лог);					
			КонецЕсли;
			
			// ТабличныеЧасти
			ТабличныеЧасти = Неопределено;
			МетаданныеОбъекта.Свойство("ТабличныеЧасти", ТабличныеЧасти); 
			
			Если ТипЗнч(ТабличныеЧасти) = Тип("Массив") Тогда 
				Для каждого СтуктураТабличнаяЧасть Из ТабличныеЧасти Цикл 
					ИмяТЧ = Неопределено;
					СтуктураТабличнаяЧасть.Свойство("Имя", ИмяТЧ);
					
					Если ИмяТЧ = "" Тогда Продолжить; КонецЕсли;
					
					ТабличнаяЧасть = Неопределено;
					СтуктураТабличнаяЧасть.Свойство("ТабличнаяЧасть", ТабличнаяЧасть);
					
					Попытка
						НовыйОбъект[ИмяТЧ].Очистить();
					Исключение
						СтрокаЛога = НСтр("ru = 'Ошибка очистки табличной части %1'");
						СтрокаЛога = СтрШаблон(СтрокаЛога, ИмяТЧ); 
						ДобавитьВЛог(Лог, СтрокаЛога);
					КонецПопытки;
					
					Если ТипЗнч(ТабличнаяЧасть) = Тип("Массив") Тогда
						Для каждого СтруктураСтрокиТЧ Из ТабличнаяЧасть Цикл
							Попытка
								НоваяСтрока = НовыйОбъект[ИмяТЧ].Добавить();
							Исключение
								СтрокаЛога = НСтр("ru = 'Ошибка добавления строки табличной части %1'");
								СтрокаЛога = СтрШаблон(СтрокаЛога, ИмяТЧ); 
								ДобавитьВЛог(Лог, СтрокаЛога);
								Продолжить;
							КонецПопытки;							
							
							РеквизитыСтрокиТабличнойЧасти = Неопределено;
							СтруктураСтрокиТЧ.Свойство("СтрокаТабличнойЧасти", РеквизитыСтрокиТабличнойЧасти);
							
							Если ТипЗнч(РеквизитыСтрокиТабличнойЧасти) = Тип("Массив") Тогда
								УстановкаРеквизитов(РеквизитыСтрокиТабличнойЧасти, НоваяСтрока, Лог);
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			НовыйОбъект.Записать();
			Загружено = Загружено + 1;
		Исключение 
			СтрокаЛога = НСтр("ru = 'Ошибка записи %1'");
			СтрокаЛога = СтрШаблон(СтрокаЛога, НовыйОбъект);
			СтрокаЛога = СтрокаЛога + Символы.ПС + ОписаниеОшибки(); 
			ДобавитьВЛог(Лог, СтрокаЛога);
		КонецПопытки;		
	КонецЦикла;
	
	Возврат Лог;
	
КонецФункции

&НаСервере
Процедура УстановкаРеквизитов(РеквизитыМассив, ЗаполняемыйОбъект, Лог) 
	
	Для каждого Реквизит Из РеквизитыМассив Цикл
		РеквизитИмя = Неопределено;
		Реквизит.Свойство("Имя", РеквизитИмя);
		
		РеквизитТип = Неопределено;
		Реквизит.Свойство("Тип", РеквизитТип);
		
		Если РеквизитТип = "Число" Или РеквизитТип = "Строка" 
			Или РеквизитТип = "Булево" Или РеквизитТип = "Дата" Тогда
			
			РеквизитЗначение = Неопределено;
			Реквизит.Свойство("Значение", РеквизитЗначение); 
			
			Если РеквизитТип = "Число" Тогда
				Попытка
					РеквизитЗначение = Число(РеквизитЗначение);
				Исключение
					РеквизитЗначение = 0;
				КонецПопытки;
				
			ИначеЕсли РеквизитТип = "Булево" Тогда
				РеквизитЗначение = ?(РеквизитЗначение = "Истина", Истина, Ложь);
				
			ИначеЕсли РеквизитТип = "Дата" Тогда
				Попытка
					РеквизитЗначение = Дата(РеквизитЗначение);
				Исключение
					РеквизитЗначение = Дата(1,1,1);
				КонецПопытки;
			КонецЕсли;
			
		ИначеЕсли РеквизитТип = "Справочник" 
			Или РеквизитТип = "ПланВидовХарактеристик" 
			Или РеквизитТип = "ПланОбмена" Тогда
			
			РеквизитИмяМД = Неопределено;
			Реквизит.Свойство("ИмяМетаданных", РеквизитИмяМД);
			
			РеквизитКод = Неопределено;
			Реквизит.Свойство("Код", РеквизитКод);
			
			РеквизитНаименование = Неопределено;
			Реквизит.Свойство("Наименование", РеквизитНаименование); 
			
			РеквизитЗначение = ПолучитьСправочник(РеквизитИмяМД,, РеквизитНаименование, РеквизитТип); 
			
			Если Не ЗначениеЗаполнено(РеквизитЗначение) Тогда
				РеквизитЗначение = ПолучитьСправочник(РеквизитИмяМД, "Код", РеквизитКод, РеквизитТип); 
			КонецЕсли;
			
		ИначеЕсли РеквизитТип = "Перечисление" Тогда
			РеквизитИмяМД = Неопределено;
			Реквизит.Свойство("ИмяМетаданных", РеквизитИмяМД); 
			
			РеквизитЗначение = Неопределено;
			Реквизит.Свойство("Значение", РеквизитЗначение);
			
			РеквизитЗначение = ПолучитьПеречисление(РеквизитИмяМД, РеквизитЗначение); 
			
		ИначеЕсли РеквизитТип = "Документ" Тогда 
			РеквизитИмяМД = Неопределено;
			Реквизит.Свойство("ИмяМетаданных", РеквизитИмяМД);
			
			РеквизитНомер = Неопределено;
			Реквизит.Свойство("Номер", РеквизитНомер);
			
			РеквизитДата = Неопределено;
			Реквизит.Свойство("Дата", РеквизитДата); 
			
			Попытка
				РеквизитДата = Дата(РеквизитДата);
			Исключение
				РеквизитДата = Дата(1,1,1);
			КонецПопытки;
			
			РеквизитЗначение = ПолучитьДокумент(РеквизитИмяМД, РеквизитНомер, РеквизитДата);
		КонецЕсли;
		
		// установка значения ревизита
		Попытка
			ЗаполняемыйОбъект[РеквизитИмя] = РеквизитЗначение; 
			
			Если Не (РеквизитТип = "Число" Или РеквизитТип = "Строка" 
				Или РеквизитТип = "Булево" Или РеквизитТип = "Дата") 
				И Не ЗначениеЗаполнено(РеквизитЗначение) Тогда
				
				ТекстОшибки = НСтр("ru = '! Установлено пустое значение реквизита %1.'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, РеквизитИмя);
				ДобавитьВЛог(Лог, ТекстОшибки);
			КонецЕсли;
		Исключение
			ТекстОшибки = НСтр("ru = '!!! Не установлено значение реквизита %1.'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, РеквизитИмя);
			ДобавитьВЛог(Лог, ТекстОшибки);
		КонецПопытки;
	КонецЦикла;
				
КонецПроцедуры

&НаСервере
Функция ПолучитьСправочник(ИмяСправочника, ИмяРеквизита = "Наименование", ЗначениеРеквизита, ТипДанных = "Справочник")
	
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;		
	
	Если ТипДанных = "ПланОбмена" Тогда
		Если Метаданные.ПланыОбмена.Найти(ИмяСправочника) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипДанных = "ПланВидовХарактеристик" Тогда   
		Если Метаданные.ПланыВидовХарактеристик.Найти(ИмяСправочника) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Если Метаданные.Справочники.Найти(ИмяСправочника) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Значение", ЗначениеРеквизита);
		
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Спр.Ссылка КАК Ссылка
    |ИЗ
    |   Справочник." + ИмяСправочника + " КАК Спр
    |ГДЕ
    |   Спр." + ИмяРеквизита + " = &Значение
    |УПОРЯДОЧИТЬ ПО
    |   Спр.Ссылка";
	
	Если ТипДанных <> "Справочник" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник", ТипДанных);
	КонецЕсли;

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    Возврат Неопределено;

КонецФункции

&НаСервере
Функция ПолучитьДокумент(ИмяДокумента, НомерДокумента, ДатаДокумента) 

    Если Метаданные.Документы.Найти(ИмяДокумента) = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    // Этап 1. Точное совпадение номера и даты.
    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", НомерДокумента);
    Запрос.УстановитьПараметр("Дата", ДатаДокумента);

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Док.Ссылка КАК Ссылка
    |ИЗ
    |   Документ." + ИмяДокумента + " КАК Док
    |ГДЕ
    |   Док.Номер = &Номер
    |   И Док.Дата = &Дата";

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    // Этап 2. Точного совпадения нет.
    // Выбираем документ с тем же номером
    // и самой поздней датой.
    Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", НомерДокумента);

    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |   Док.Ссылка КАК Ссылка
    |ИЗ
    |   Документ." + ИмяДокумента + " КАК Док
    |ГДЕ
    |   Док.Номер = &Номер
    |УПОРЯДОЧИТЬ ПО
    |   Док.Дата УБЫВ,
    |   Док.Ссылка";

    Выборка = Запрос.Выполнить().Выбрать();

    Если Выборка.Следующий() Тогда
        Возврат Выборка.Ссылка;
    КонецЕсли;

    // Документ не найден.
    Возврат Неопределено;

КонецФункции   

&НаСервере
Функция ПолучитьПеречисление(ИмяПеречисления, ИмяЗначения) 

    МетаданныеПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);

    Если МетаданныеПеречисления = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Для каждого ЗначениеМД Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
        Если ЗначениеМД.Имя = ИмяЗначения Тогда
            Возврат Перечисления[ИмяПеречисления][ЗначениеМД.Имя];
        КонецЕсли;
    КонецЦикла;

    Возврат Неопределено;

КонецФункции

