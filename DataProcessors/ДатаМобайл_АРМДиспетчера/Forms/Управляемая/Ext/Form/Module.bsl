		Иначе 
			ПартнерДопуска = Справочники.Партнеры.ПустаяСсылка();
			
			ТабАнализа.ТекстЗапроса = СтрЗаменить(ТабАнализа.ТекстЗапроса, "&ТекстДопускаВесовогоТовараВЕд", "0");
			
			ТабАнализа.Параметры.УстановитьЗначениеПараметра("Партнер"    , ПартнерДопуска);
			ТабАнализа.Параметры.УстановитьЗначениеПараметра("ВсеПартнеры", Не ЗначениеЗаполнено(ПартнерДопуска));
		КонецЕсли; 
	
	КонецЕсли;
	
	Попытка
		ТабАнализа.Параметры.УстановитьЗначениеПараметра("НеУчитыватьЗнаменательУпаковкиПриРасчетеКоличества", НеУчитыватьЗнаменательУпаковкиПриРасчетеКоличества);
	Исключение
	КонецПопытки;
	
