Процедура ОбработчикОжиданияЗапросаКлючаСесии()
	
	Попытка
		Модуль_ИнтерфейсИСМПКлиентСервер = ДатаМобайл_ОбщийМодульКлиент.ОбщийМодуль("ИнтерфейсИСМПКлиентСервер");
	Исключение
		Модуль_ИнтерфейсИСМПКлиентСервер = ДатаМобайл_ОбщийМодульКлиент.ОбщийМодуль("ИнтерфейсИСМПОбщегоНазначенияКлиентСервер");
	КонецПопытки;
	Модуль_ИнтерфейсАвторизацииИСМПКлиент = ДатаМобайл_ОбщийМодульКлиент.ОбщийМодуль("ИнтерфейсАвторизацииИСМПКлиент");   
	Модуль_ИнтерфейсАвторизацииИСМПВызовСервера = ДатаМобайл_ОбщийМодульКлиент.ОбщийМодуль("ИнтерфейсАвторизацииИСМПВызовСервера");
	
	ИсходныеДанные = ПолучитьИсходныеДанные(); 
	
	ФормаОткрыта = Ложь;
	
	Для каждого СтрокаИсходныхДанных Из ИсходныеДанные Цикл
		//Попытка
		//	ВозвращаемоеЗначение = ОбменЧерезСУЗ(СтрокаИсходныхДанных);
		//	ПараметрыЗапроса = Модуль_ИнтерфейсИСМПКлиентСервер.ПараметрыЗапросаКлючаСессииСУЗ(ВозвращаемоеЗначение.Запись);
		//	Модуль_ИнтерфейсАвторизацииИСМПКлиент.ЗапроситьКлючСессии(ПараметрыЗапроса, Неопределено);
		//Исключение
		//КонецПопытки; 
		
		//Попытка
		//	Если ВозвращаемоеЗначение.КодСостояния = 400 Тогда
		//		ОтключитьОбработчикОжидания("ОбработчикОжиданияЗапросаКлючаСесии");
		//		Прервать;
		//	КонецЕсли;
		//Исключение КонецПопытки;
		
		Организация = СтрокаИсходныхДанных.Значение;
		
		Попытка  
			Модуль_ИнтерфейсИСМПКлиентСервер = ДатаМобайл_ОбщийМодульКлиент.ОбщийМодуль("ИнтерфейсИСМПКлиентСервер");
			ПараметрыЗапроса = Модуль_ИнтерфейсИСМПКлиентСервер.ПараметрыЗапросаКлючаСессии(Организация);
		Исключение        
			Модуль_ОбщегоНазначенияИСМПКлиентСервер = ДатаМобайл_ОбщийМодульКлиент.ОбщийМодуль("ОбщегоНазначенияИСМПКлиентСервер");
			ПараметрыЗапроса = Модуль_ОбщегоНазначенияИСМПКлиентСервер.ПараметрыЗапросаКлючаСессии(Организация);
		КонецПопытки;
		
		ТребуетсяОбновлениеКлючаСессии = Модуль_ИнтерфейсАвторизацииИСМПВызовСервера.ТребуетсяОбновлениеКлючаСессии(ПараметрыЗапроса);
		
		Если ТребуетсяОбновлениеКлючаСессии Тогда						
			ПроверитьФормаОткрыта(ФормаОткрыта);
					
			Если Не ФормаОткрыта Тогда // условие, чтобы не спамить окнами
				Попытка
					Модуль_ИнтерфейсАвторизацииИСМПКлиент.ЗапроситьКлючСессии(
