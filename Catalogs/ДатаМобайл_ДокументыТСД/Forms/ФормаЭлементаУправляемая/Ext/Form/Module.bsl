&НаКлиенте
Процедура ИзменитьВидимостьВкладокПодборРазмещение()   
	
	Если ЗначениеЗаполнено(Объект.ДатаЗавершения) Тогда
		ВключенаГрупповаяРабота = Ложь;
		ВключеноБыстроеСканирование = Ложь;
	КонецЕсли;
	
	ЕстьПодчиненныеДокументы = (Объект.СписокДокументов.Количество() > 0 
	И ЭтоШаблонНесколькоДокументов(Объект.Шаблон));
	
	//Элементы.ГрПодбор.Видимость = (Не ВключенаГрупповаяРабота И Не ЕстьПодчиненныеДокументы);
	//Элементы.ГрРазмещение.Видимость = (Не ВключенаГрупповаяРабота И Не ЕстьПодчиненныеДокументы);
	Элементы.ГрПодборГрупповаяРабота.Видимость = ВключенаГрупповаяРабота Или ВключеноБыстроеСканирование;
	Элементы.ГрРазмещениеГрупповаяРабота.Видимость = ВключенаГрупповаяРабота Или ВключеноБыстроеСканирование;     
	
	УстановитьОтборыСписковСтрокГрупповойРаботы(ВключенаГрупповаяРабота,ВключеноБыстроеСканирование);	              		
	Элементы.ТСД.Доступность = Не РеквизитГрупповаяРабота(Объект.Шаблон);	
	Элементы.ГрТерминалы.Видимость = РеквизитГрупповаяРабота(Объект.Шаблон);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборыСписковСтрокГрупповойРаботы(ВключенаГрупповаяРабота,ВключеноБыстроеСканирование)
	
	Если ВключенаГрупповаяРабота Или ВключеноБыстроеСканирование Тогда
		СписокСтрокПодбораГрупповаяРабота.Параметры.УстановитьЗначениеПараметра("ДокументТСД", Объект.Ссылка);
		СписокСтрокРазмещенияГрупповаяРабота.Параметры.УстановитьЗначениеПараметра("ДокументТСД", Объект.Ссылка);
	Иначе
		СписокСтрокПодбораГрупповаяРабота.Параметры.УстановитьЗначениеПараметра("ДокументТСД", Справочники.ДатаМобайл_ДокументыТСД.ПустаяСсылка());
		СписокСтрокРазмещенияГрупповаяРабота.Параметры.УстановитьЗначениеПараметра("ДокументТСД", Справочники.ДатаМобайл_ДокументыТСД.ПустаяСсылка());   
	КонецЕсли;	
	
КонецПроцедуры

