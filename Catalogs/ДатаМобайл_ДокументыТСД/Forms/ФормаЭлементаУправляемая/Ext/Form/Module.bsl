// Функция - получает структуру настроек из шаблона
//
// Параметры:
//  Шаблон - СправочникСсылка.ДатаМобайл_ШаблоныДокументов - Ссылка на шаблон
// 
//
&НаСервереБезКонтекста
Функция НастройкиРаботыСНаборами(Шаблон)
	
	СтруктураНастроек = Новый Структура; 
	
	СтруктураНастроек.Вставить("СоздаватьДокументИСМП", Шаблон.СоздаватьДокументИСМП);
	СтруктураНастроек.Вставить("РежимКомплектации", Шаблон.РежимКомплектации);
	СтруктураНастроек.Вставить("КоллективнаяРаботаСДокументмТСД", Шаблон.ГрупповаяРабота);
	
	Возврат СтруктураНастроек;
	
КонецФункции

#КонецОбласти

