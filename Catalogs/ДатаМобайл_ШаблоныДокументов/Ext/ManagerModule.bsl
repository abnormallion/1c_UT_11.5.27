// Функция - возвращает признак выводить в документе ТСД
//  реквизит "Новый документ" как табличную часть
//
// Параметры:
//  ШаблонСсылка - СправочникСсылка.ДатаМобайл_ШаблоныДокументов - Ссылка на шаблон
// 
// Возвращаемое значение:
//   Булево 
//
Функция НовыйДокументКакТабличнаяЧасть(ШаблонСсылка) Экспорт

	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(ШаблонСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ШаблоныДокументов.ВидДокументаНового КАК ВидДокументаНового
	|ИЗ
	|	Справочник.ДатаМобайл_ШаблоныДокументов КАК ШаблоныДокументов
	|ГДЕ
	|	ШаблоныДокументов.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", ШаблонСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если СокрЛП(Выборка.ВидДокументаНового) = "ВыводИзОборотаИСМП" Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

