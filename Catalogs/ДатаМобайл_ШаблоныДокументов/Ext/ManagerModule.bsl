// Функция - возвращает значения параметров шаблона
//
// Параметры:
//  ШаблонСсылка - СправочникСсылка.ДатаМобайл_ШаблоныДокументов - Ссылка на шаблон
//  СписокПараметров - Строка - Список параметров шаблона через запятую
// 
// Возвращаемое значение:
//   Структура 
//
Функция ПолучитьПараметрыШаблона(ШаблонСсылка, СписокПараметров = Неопределено) Экспорт
	
	Если СписокПараметров = Неопределено Тогда
		ПараметрыШаблона = ПолучитьСтруктуруРеквизитовШаблона();
	Иначе 
		ПараметрыШаблона = Новый Структура;
		СписокПараметров = СтрЗаменить(СписокПараметров, "", "");
		СписокПараметров = СтрЗаменить(СписокПараметров, Символы.ПС, "");
		СписокПараметровШаблона = СтрЗаменить(СписокПараметров, ",", Символы.ПС);
		
		КоличествоПараметров = СтрЧислоСтрок(СписокПараметровШаблона);
		
		Для сч = 1 По КоличествоПараметров Цикл 
			ПараметрыШаблона.Вставить(СтрПолучитьСтроку(СписокПараметровШаблона, сч));
		КонецЦикла;
	КонецЕсли;
	
	ТелоЗапроса = "";
	Первый = Истина;
	
	Для каждого ПараметрШаблона Из ПараметрыШаблона Цикл
		ТелоЗапроса = ТелоЗапроса + ?(Первый, "", "," + Символы.ПС + "	") + ПараметрШаблона.Ключ + " КАК " + ПараметрШаблона.Ключ;
		Первый = Ложь;
	КонецЦикла;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Шаблон", ШаблонСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	1 = 1
	|ИЗ
	|	Справочник.ДатаМобайл_ШаблоныДокументов КАК ШаблоныДокументов
	|ГДЕ
	|	ШаблоныДокументов.Ссылка = &Шаблон";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", ТелоЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыШаблона, Выборка);
	КонецЕсли;
		
	Возврат ПараметрыШаблона;
	
КонецФункции

// Функция - возвращает значения параметров таб. части шаблона
//
// Параметры:
//  ШаблонСсылка - СправочникСсылка.ДатаМобайл_ШаблоныДокументов - Ссылка на шаблон
//  СписокПараметров - Строка - Список параметров шаблона через запятую
// 
// Возвращаемое значение:
//   Структура 
//
Функция ПолучитьПараметрыТабЧастиШаблона(ШаблонСсылка, ИмяТабЧасти, СписокПараметров = Неопределено) Экспорт
	
	Если СписокПараметров = Неопределено Тогда
		ПараметрыШаблона = Новый Структура;
		
		Для каждого Реквизит Из Метаданные.Справочники.ДатаМобайл_ШаблоныДокументов.ТабличныеЧасти[ИмяТабЧасти].Реквизиты Цикл
			ПараметрыШаблона.Вставить(Реквизит.Имя);
		КонецЦикла;
	Иначе
		ПараметрыШаблона = Новый Структура;		
		СписокПараметров = СтрЗаменить(СписокПараметров, "", "");
		СписокПараметров = СтрЗаменить(СписокПараметров, Символы.ПС, "");
		СписокПараметровШаблона = СтрЗаменить(СписокПараметров, ",", Символы.ПС);
		
		КоличествоПараметров = СтрЧислоСтрок(СписокПараметровШаблона);
		
		Для сч = 1 По КоличествоПараметров Цикл 
			ПараметрыШаблона.Вставить(СтрПолучитьСтроку(СписокПараметровШаблона, сч));
		КонецЦикла;
	КонецЕсли;
	
	ТелоЗапроса = "";
	Первый = Истина;
	
	Для каждого ПараметрШаблона Из ПараметрыШаблона Цикл
		ТелоЗапроса = ТелоЗапроса + ?(Первый, "", "," + Символы.ПС + "	") + ПараметрШаблона.Ключ + " КАК " + ПараметрШаблона.Ключ;
		Первый = Ложь;
	КонецЦикла;
	
	Запрос = Новый Запрос; 
	Запрос.УстановитьПараметр("Шаблон", ШаблонСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	1 = 1
	|ИЗ
	|	Справочник.ДатаМобайл_ШаблоныДокументов. " + ИмяТабЧасти + " КАК ШаблоныДокументов
	|ГДЕ
	|	ШаблоныДокументов.Ссылка = &Шаблон";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", ТелоЗапроса);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыШаблона, Выборка);
	КонецЕсли;
		
	Возврат ПараметрыШаблона;
	
КонецФункции

